page {
  --yj-panel-border: #d3af73;
  --yj-panel-radius: 26rpx;
  min-height: 100%;
  background: #fbf8f0;
  color: #262b29;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

view, text, button, input, picker-view, picker-view-column {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.tap-pressed, .is-opening {
  opacity: 0.72;
}

.navigation-status {
  position: fixed;
  top: 24rpx;
  left: 50%;
  z-index: 80;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #eadbbf;
  border-radius: 30rpx;
  background: #fbf2dc;
  color: #775119;
  font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx));
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 6rpx 18rpx rgba(40, 42, 41, 0.09);
  transform: translateX(-50%);
}

.navigation-spinner {
  width: 21rpx;
  height: 21rpx;
  border: 3rpx solid #dec999;
  border-top-color: #775119;
  border-radius: 50%;
  animation: navigation-spin 0.8s linear infinite;
}

@keyframes navigation-spin {
  to { transform: rotate(360deg); }
}

.page-shell {
  position: relative;
  z-index: 0;
  min-height: 100vh;
  font-size: 30rpx;
  font-size: calc(30rpx + var(--yj-font-step, 0rpx));
  padding: 20rpx 28rpx 40rpx;
  border-left: 1rpx solid #d6b876;
  border-right: 1rpx solid #d6b876;
}

.paper-backdrop {
  position: absolute;
  z-index: -1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
}

.paper-backdrop-plum {
  position: absolute;
  top: 0;
  left: -95rpx;
  width: 250rpx;
  opacity: 0.6;
}

.paper-backdrop-mountains {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  opacity: 0.48;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 30rpx 0 16rpx;
  font-size: 27rpx;
  font-size: calc(27rpx + var(--yj-font-step, 0rpx));
  font-weight: 700;
  color: #3e281b;
}

.section-heading::before {
  display: none;
}

.surface-card {
  background: #fffdf8;
  border: 1rpx solid var(--yj-panel-border);
  border-radius: var(--yj-panel-radius);
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}

.paper-feature-hero {
  border: 1rpx solid var(--yj-panel-border);
  border-radius: var(--yj-panel-radius);
  background: linear-gradient(135deg, #fffdf8, #f9f5e9);
  color: #3e281b;
  box-shadow: 0 6rpx 0 #f3e9d6, 0 12rpx 19rpx rgba(103, 70, 26, 0.1);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #eadbbf;
  border-radius: 44rpx;
  background: #fbf2dc;
  color: #775119;
  font-size: 29rpx; font-size: calc(29rpx + var(--yj-font-step, 0rpx));
  font-weight: 700;
  line-height: 1;
}

.demo-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: #fbf2dc;
  color: #71500c;
  font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx));
  font-weight: 600;
  white-space: nowrap;
}

.secondary-text {
  color: #87909a;
}

.tone-earth { color: #8a5b09; }
.tone-fire { color: #a82420; }
.tone-water { color: #0c5f92; }
.tone-wood { color: #0d6e52; }
.tone-metal { color: #755d17; }
