<view wx:if="{{navigationVisible}}" class="navigation-status"><view class="navigation-spinner"></view><text>正在打开…</text></view>
<view class="page-shell mine-page" style="--yj-font-step: {{fontStep || 0}}rpx">
  <view class="paper-backdrop" aria-hidden="true"><image class="paper-backdrop-plum" src="/assets/home-plum-branch.png" mode="widthFix"></image><image class="paper-backdrop-mountains" src="/assets/home-ink-mountains.png" mode="widthFix"></image></view>
  <view wx:if="{{profileLoading && !loggedIn}}" class="mine-state surface-card">正在读取个人资料…</view>
  <view wx:elif="{{profileError}}" class="mine-state surface-card">
    <text>个人资料暂时无法读取</text>
    <text class="mine-state-note">{{profileError}}</text>
    <button class="mine-state-action" bindtap="loadProfile">重新加载</button>
  </view>
  <button wx:elif="{{!loggedIn}}" class="account-row account-row-login surface-card" hover-class="tap-pressed" disabled="{{loggingIn}}" bindtap="openLogin">
    <view class="avatar avatar-guest"><view class="avatar-head"></view><view class="avatar-shoulders"></view></view>
    <view class="account-copy"><text>{{loggingIn ? '正在登录…' : '微信一键登录'}}</text><text>登录后保存排盘与个人资料</text></view>
    <text class="account-action">登录 ›</text>
  </button>
  <view wx:else class="account-row account-row-logged surface-card {{navigationKey === 'profile' ? 'is-opening' : ''}}" hover-class="tap-pressed" bindtap="openProfile" role="button">
    <view class="avatar avatar-logged"><image wx:if="{{userAvatarUrl}}" class="avatar-image" src="{{userAvatarUrl}}" mode="aspectFill" /><text wx:else>缘</text></view>
    <view class="account-copy"><text>{{user.nickname || '缘聚用户'}}</text><text>{{user.email || '微信账号'}}</text></view>
    <text class="account-action">编辑 ›</text>
  </view>

  <block wx:if="{{loggedIn}}">
    <view class="mine-chart-card surface-card {{personalChart ? 'mine-chart-card--bound' : ''}}" hover-class="{{personalChart ? 'tap-pressed' : 'none'}}" bindtap="openPersonalChart" role="button">
      <view class="mine-chart-heading"><text class="mine-chart-kicker">本人命盘</text><text wx:if="{{personalChart}}" class="mine-chart-view">查看详情 ›</text></view>
      <view wx:if="{{personalChartLoading}}" class="mine-chart-content">
        <text class="mine-chart-title">正在读取绑定状态…</text>
        <text class="mine-chart-note">请稍候</text>
      </view>
      <view wx:elif="{{personalChart}}" class="mine-chart-content mine-chart-content--bound {{navigationKey === 'result' ? 'is-opening' : ''}}">
        <text wx:if="{{personalChart.name !== '我的干支'}}" class="mine-chart-custom-name">{{personalChart.name}}</text>
        <view class="mine-chart-pillars"><view class="mine-chart-pillar {{pillarIndex === 2 ? 'is-day' : ''}}" wx:for="{{personalChart.columns}}" wx:for-item="pillar" wx:for-index="pillarIndex" wx:key="key"><text class="mine-chart-pillar-label">{{pillarIndex === 0 ? '年柱' : pillarIndex === 1 ? '月柱' : pillarIndex === 2 ? '日柱' : '时柱'}}</text><text class="mine-chart-pillar-value">{{pillar.gan}}</text><text class="mine-chart-pillar-value">{{pillar.zhi}}</text></view></view>
        <view class="mine-chart-footer"><view class="mine-chart-date"><text class="mine-chart-date-label">出生 · </text><text>{{personalChart.date}}</text></view><view class="mine-chart-edit" catchtap="openCreateChart" role="button">修改资料</view></view>
      </view>
      <view wx:elif="{{personalChartError}}" class="mine-chart-content" hover-class="tap-pressed" bindtap="openPersonalBanner" role="button">
        <text class="mine-chart-title">暂时无法读取绑定状态</text>
        <text class="mine-chart-note">{{personalChartError}}</text>
        <text class="mine-chart-link">重新读取 ›</text>
      </view>
      <view wx:elif="{{chartCount > 0}}" class="mine-chart-content {{navigationKey === 'history' ? 'is-opening' : ''}}" hover-class="tap-pressed" bindtap="openPersonalBanner" role="button">
        <text class="mine-chart-title">尚未设置本人命盘</text>
        <text class="mine-chart-note">填写本人出生资料，或从已有记录中选择自己的命盘。</text>
        <text class="mine-chart-link" catchtap="openCreateChart">填写本人资料 ›</text>
        <text class="mine-chart-link">从历史选择 ›</text>
      </view>
      <view wx:else class="mine-chart-content">
        <text class="mine-chart-title">尚未设置本人命盘</text>
        <text class="mine-chart-note">填写自己的出生资料，保存后即可查看本人命盘。</text>
        <text class="mine-chart-link" bindtap="openCreateChart">去设置 ›</text>
      </view>
    </view>

  </block>

  <view wx:if="{{!loggedIn && !profileLoading && !profileError}}" class="mine-guest-note surface-card">
    <text>从一份自己的排盘开始</text>
    <text>登录后可配置本人命盘，查看个人参考。</text>
  </view>

  <view class="mine-settings-title">设置与帮助</view>
  <view class="settings-card surface-card">
    <view class="settings-row" hover-class="tap-pressed" bindtap="chooseFontSize" role="button"><text class="settings-label">字体大小</text><text class="settings-value">{{fontModeLabel || '跟随微信'}}</text><text class="mine-chevron">›</text></view>
    <view wx:if="{{loggedIn && !user.email}}" class="settings-row" hover-class="tap-pressed" bindtap="toggleWebBinding" role="button"><text class="settings-label">绑定已有网页账号</text><text class="mine-chevron">›</text></view>
    <view wx:if="{{loggedIn && user.email}}" class="settings-row settings-row-bound"><text class="settings-label">已绑定网页账号</text><text class="settings-bound-email">{{user.email}}</text></view>
    <view class="settings-row" hover-class="tap-pressed" bindtap="openPrivacy" role="button"><text class="settings-label">隐私说明</text><text class="mine-chevron">›</text></view>
    <view class="settings-row" hover-class="tap-pressed" bindtap="openAbout" role="button"><text class="settings-label">关于缘聚</text><text class="mine-chevron">›</text></view>
  </view>

  <view wx:if="{{loggedIn && bindingVisible && !user.email}}" class="surface-card web-binding-card">
    <view class="web-binding-title">绑定已有网页账号</view>
    <view class="web-binding-note">验证网页账号后，两端历史会合并，网页账号将成为主账号。</view>
    <input class="note-input" type="text" placeholder="网页账号邮箱" value="{{email}}" bindinput="onEmailInput" />
    <input class="note-input" password="true" placeholder="网页账号密码" value="{{password}}" bindinput="onPasswordInput" />
    <button class="primary-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="bindWebAccount">确认绑定并合并历史</button>
  </view>

  <view wx:if="{{officialAccountGuide}}" class="official-account-card surface-card" hover-class="tap-pressed" bindtap="openOfficialAccountGuide" role="button">
    <view class="official-account-card-top">
      <text class="official-account-card-eyebrow">关注公众号</text>
      <text class="official-account-card-action">查看二维码 ›</text>
    </view>
    <text class="official-account-card-name">{{officialAccountGuide.name}}</text>
    <text class="official-account-card-description">{{officialAccountGuide.description}}</text>
  </view>

  <button wx:if="{{loggedIn}}" class="mine-logout" bindtap="logoutPreview">退出登录</button>
</view>

<view wx:if="{{officialAccountOpen && officialAccountGuide}}" class="official-account-overlay" style="--yj-font-step: {{fontStep || 0}}rpx" bindtap="closeOfficialAccountGuide">
  <view class="official-account-sheet" catchtap="stopOfficialAccountTap">
    <view class="official-account-handle"></view>
    <text class="official-account-sheet-title">{{officialAccountGuide.name}}</text>
    <text class="official-account-sheet-note">{{officialAccountGuide.description}}</text>
    <image wx:if="{{!officialAccountQRFailed}}" class="official-account-qr" src="{{officialAccountGuide.qrUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="previewOfficialAccountQR" binderror="officialAccountImageError" />
    <view wx:else class="official-account-qr-error">二维码暂时无法显示，请复制微信号搜索</view>
    <text class="official-account-wechat-id">微信号：{{officialAccountGuide.wechat_id}}</text>
    <button class="official-account-copy" bindtap="copyOfficialAccountID">复制微信号</button>
    <button class="official-account-close" bindtap="closeOfficialAccountGuide">关闭</button>
  </view>
</view>
