.mine-page { padding-top: 16rpx; }
.account-row { display: flex; align-items: center; height: 130rpx; padding: 0 8rpx; }
.avatar { position: relative; width: 92rpx; height: 92rpx; flex-shrink: 0; overflow: hidden; border: 4rpx solid #fff; border-radius: 50%; background: linear-gradient(145deg, #e7e8ea, #f9f9f9); box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); }
.avatar-head { position: absolute; top: 24rpx; left: 29rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: #c9cbcd; }
.avatar-shoulders { position: absolute; bottom: -7rpx; left: 16rpx; width: 58rpx; height: 37rpx; border-radius: 50% 50% 0 0; background: #c9cbcd; }
.avatar-logged { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #e1b24d, #c88e23); color: #fff; }
.avatar-logged text { font-size: 37rpx; font-weight: 700; }
.account-copy { display: flex; flex: 1; flex-direction: column; gap: 9rpx; margin-left: 23rpx; }
.account-copy > text:first-child { font-size: 30rpx; font-weight: 700; }
.account-copy > text:last-child { color: #5f6b74; font-size: 24rpx; }
.account-row-logged .account-copy { min-width: 0; gap: 6rpx; }
.login-demo-badge { display: inline-block; margin-left: 8rpx; padding: 4rpx 9rpx; border-radius: 9rpx; background: #f8eed7; color: #aa741c; font-size: 18rpx; font-weight: 600; vertical-align: middle; }
.row-arrow { color: #9fa8b1; font-size: 36rpx; }
.brand-banner { position: relative; display: flex; height: 202rpx; flex-direction: column; justify-content: center; margin-top: 17rpx; overflow: hidden; padding: 0 37rpx; border-radius: 21rpx; background: linear-gradient(130deg, #262b2e, #111719); color: #fff; }
.brand-title { color: #f9d580; font-size: 39rpx; font-weight: 700; letter-spacing: 4rpx; }
.brand-subtitle { margin-top: 10rpx; color: #e5e7e8; font-size: 23rpx; }
.banner-pattern { position: absolute; right: -9rpx; width: 45rpx; height: 120rpx; border-radius: 100% 0 100% 0; background: rgba(145, 151, 151, 0.12); transform: rotate(40deg); }
.leaf-one { top: 9rpx; right: 14rpx; }
.leaf-two { top: 25rpx; right: 64rpx; transform: rotate(63deg); }
.leaf-three { top: 63rpx; right: 8rpx; transform: rotate(17deg); }
.resume-banner { height: 226rpx; justify-content: flex-start; padding-top: 24rpx; }
.resume-kicker { color: #d3af64; font-size: 20rpx; }
.resume-title { margin-top: 9rpx; color: #fff; font-size: 31rpx; font-weight: 700; }
.resume-pillars { display: flex; gap: 14rpx; margin-top: 11rpx; }
.resume-pillars text { padding: 5rpx 10rpx; border: 1rpx solid rgba(236, 205, 138, 0.25); border-radius: 9rpx; color: #f5d180; font-size: 22rpx; }
.resume-bottom { display: flex; justify-content: space-between; margin-top: 12rpx; color: #c2c9ca; font-size: 20rpx; }
.resume-bottom text:last-child { color: #f4d17d; font-weight: 700; }
.chart-summary { display: flex; align-items: center; gap: 17rpx; margin-top: 22rpx; padding: 21rpx 23rpx; }
.chart-summary-icon { display: flex; width: 57rpx; height: 57rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 16rpx; background: #f9efd9; color: #be8723; font-size: 29rpx; }
.chart-summary-copy { display: flex; flex: 1; flex-direction: column; gap: 5rpx; }
.chart-summary-copy text:first-child { color: #32383c; font-size: 25rpx; font-weight: 700; }
.chart-summary-copy text:last-child { color: #8b949e; font-size: 20rpx; }
.chart-summary-count { color: #b98221; font-size: 24rpx; font-weight: 700; }
.recent-charts { margin-top: 22rpx; padding: 0 24rpx; }
.recent-charts-head { display: flex; height: 67rpx; align-items: center; justify-content: space-between; }
.recent-charts-head text:first-child { color: #2b3033; font-size: 26rpx; font-weight: 700; }
.recent-charts-head text:last-child { color: #b1802c; font-size: 20rpx; }
.recent-chart { position: relative; padding: 15rpx 28rpx 18rpx 0; border-top: 1rpx solid #f0eee9; }
.recent-chart > view:first-child { display: flex; align-items: baseline; gap: 14rpx; }
.recent-chart-name { color: #32383c; font-size: 24rpx; font-weight: 700; }
.recent-chart-date { color: #5f6b74; font-size: 23rpx; }
.recent-chart-empty { padding: 20rpx 0 25rpx; border-top: 1rpx solid #f0eee9; color: #5f6b74; font-size: 24rpx; }
.recent-chart-pillars { display: flex; gap: 17rpx; margin-top: 9rpx; font-size: 23rpx; font-weight: 700; }
.recent-chart-arrow { position: absolute; right: 0; top: 35rpx; color: #adb5bb; font-size: 31rpx; }
.tool-card { margin-top: 28rpx; padding: 6rpx 22rpx 22rpx; }
.tool-card .section-heading { margin: 17rpx 0 20rpx; }
.tool-grid { display: flex; justify-content: space-between; }
.tool-item { display: flex; width: 25%; flex-direction: column; align-items: center; gap: 10rpx; color: #4f5c65; font-size: 23rpx; white-space: nowrap; }
.tool-icon { display: flex; width: 79rpx; height: 79rpx; align-items: center; justify-content: center; border-radius: 23rpx; font-size: 46rpx; font-weight: 700; }
.tool-icon.share { background: #f1efff; color: #a55de5; }
.tool-icon.contact { background: #eaf9f3; color: #328de8; }
.tool-icon.channel { background: #fff4ec; color: #288ee7; }
.tool-icon.feedback { background: #f6f0ff; color: #d59522; }
.settings-card { margin-top: 25rpx; padding: 4rpx 24rpx; }
.settings-row { display: flex; height: 84rpx; align-items: center; border-bottom: 1rpx solid #f0f0f0; }
.settings-row:last-child { border-bottom: 0; }
.settings-icon { width: 50rpx; color: #87909a; font-size: 28rpx; }
.settings-label { flex: 1; color: #414d57; font-size: 24rpx; }
.logout-preview { display: flex; height: 76rpx; align-items: center; justify-content: center; margin-top: 24rpx; border: 1rpx solid #e9e3d7; border-radius: 38rpx; background: #fff; color: #9a732f; font-size: 24rpx; }
.mine-footnote { display: flex; align-items: center; justify-content: center; gap: 9rpx; margin-top: 24rpx; color: #5f6b74; font-size: 23rpx; }
