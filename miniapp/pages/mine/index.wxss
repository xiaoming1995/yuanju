.mine-page {
  padding-top: 24rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.account-row {
  display: flex;
  min-height: 132rpx;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: var(--yj-panel-radius);
  background: #fffdf8;
}

.account-row-login {
  width: 100%;
  margin: 0;
  border: 1rpx solid var(--yj-panel-border);
  line-height: 1.4;
  text-align: left;
}

.avatar {
  position: relative;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-guest { background: #f1eee8; }
.avatar-head { position: absolute; top: 20rpx; width: 29rpx; height: 29rpx; border-radius: 50%; background: #bdc1c2; }
.avatar-shoulders { position: absolute; bottom: -5rpx; width: 57rpx; height: 36rpx; border-radius: 50% 50% 0 0; background: #bdc1c2; }
.avatar-logged { background: #efe5cf; color: #8b6426; font-size: 37rpx; font-size: calc(37rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.avatar-image { width: 100%; height: 100%; }

.account-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.account-copy > text:first-child {
  display: block;
  overflow: hidden;
  color: #262b29;
  font-size: 30rpx; font-size: calc(30rpx + var(--yj-font-step, 0rpx));
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-copy > text:last-child {
  display: block;
  overflow: hidden;
  color: #6c777b;
  font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx));
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-action { flex-shrink: 0; color: #936820; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }

.mine-chart-card, .settings-card {
  border-radius: var(--yj-panel-radius);
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}

.mine-chart-card {
  min-height: 220rpx;
  margin-top: 22rpx;
  padding: 29rpx 30rpx 24rpx;
  background: #fffdf8;
  border: 1rpx solid var(--yj-panel-border);
  box-shadow: none;
}

.mine-chart-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 38rpx; }
.mine-chart-kicker {
  display: inline-block;
  color: #8a7350;
  font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx));
  font-weight: 600;
}
.mine-chart-view { flex-shrink: 0; color: #805a20; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }

.mine-chart-content { display: flex; min-height: 138rpx; flex-direction: column; justify-content: center; }
.mine-chart-title { display: block; margin-top: 15rpx; color: #252b29; font-size: 32rpx; font-size: calc(32rpx + var(--yj-font-step, 0rpx)); font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
.mine-chart-note { display: block; margin-top: 9rpx; color: #657075; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; overflow-wrap: anywhere; }
.mine-chart-pillars { display: flex; gap: 12rpx; margin-top: 26rpx; }
.mine-chart-pillar { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-start; gap: 7rpx; }
.mine-chart-pillar-label { color: #929894; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.mine-chart-pillar-value { color: #2b302e; font-size: 32rpx; font-size: calc(32rpx + var(--yj-font-step, 0rpx)); font-weight: 600; line-height: 1.25; white-space: nowrap; }
.mine-chart-footer { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 27rpx; padding-top: 16rpx; border-top: 1rpx solid #efede8; }
.mine-chart-date { min-width: 0; color: #7c8580; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); overflow-wrap: anywhere; }
.mine-chart-edit { display: flex; flex-shrink: 0; align-items: center; min-height: 50rpx; padding-left: 12rpx; color: #805a20; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
.mine-chart-link { flex-shrink: 0; align-self: flex-end; margin-top: 17rpx; color: #936820; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }

.mine-chart-card--bound { padding: 26rpx 30rpx 18rpx; }
.mine-chart-card--bound .mine-chart-heading { padding-bottom: 17rpx; border-bottom: 1rpx solid #e8d7b1; }
.mine-chart-card--bound .mine-chart-kicker { color: #3e281b; font-size: 29rpx; font-size: calc(29rpx + var(--yj-font-step, 0rpx)); }
.mine-chart-card--bound .mine-chart-view { color: #775119; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); font-weight: 500; }
.mine-chart-content--bound { min-height: 0; }
.mine-chart-custom-name { display: block; margin-top: 15rpx; color: #756e62; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); overflow-wrap: anywhere; }
.mine-chart-card--bound .mine-chart-pillars { gap: 0; margin-top: 18rpx; }
.mine-chart-card--bound .mine-chart-pillar { align-items: center; gap: 0; padding: 17rpx 2rpx 18rpx; border-left: 1rpx solid #eee7dc; }
.mine-chart-card--bound .mine-chart-pillar:first-child { border-left: 0; }
.mine-chart-card--bound .mine-chart-pillar.is-day { border-left: 0; border-radius: 12rpx; background: #f8f3e8; }
.mine-chart-card--bound .mine-chart-pillar.is-day + .mine-chart-pillar { border-left: 0; }
.mine-chart-card--bound .mine-chart-pillar-label { margin-bottom: 12rpx; color: #8f806d; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.mine-chart-card--bound .mine-chart-pillar-value { color: #3e281b; font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif; font-size: 46rpx; font-size: calc(46rpx + var(--yj-font-step, 0rpx)); font-weight: 400; line-height: 1.22; }
.mine-chart-card--bound .mine-chart-footer { margin-top: 18rpx; padding-top: 14rpx; border-top-color: #e8d7b1; }
.mine-chart-card--bound .mine-chart-date { color: #756e62; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); line-height: 1.45; }
.mine-chart-date-label { white-space: nowrap; }
.mine-chart-card--bound .mine-chart-edit { color: #775119; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }

.mine-chevron { flex-shrink: 0; color: #9da5aa; font-size: 33rpx; font-size: calc(33rpx + var(--yj-font-step, 0rpx)); font-weight: 400; }

.mine-settings-title { margin: 35rpx 4rpx 17rpx; color: #303633; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.settings-card { padding: 0 28rpx; background: #fffdf8; }
.settings-row { display: flex; min-height: 92rpx; align-items: center; gap: 16rpx; padding: 12rpx 0; border-bottom: 1rpx solid #efeeea; }
.settings-row:last-child { border-bottom: 0; }
.settings-label { min-width: 0; flex: 1; color: #414a4b; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); }
.settings-value { flex-shrink: 0; color: #788186; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); }
.settings-bound-email { max-width: 52%; overflow: hidden; color: #788186; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); text-overflow: ellipsis; white-space: nowrap; }

.mine-logout { width: 100%; min-height: 84rpx; margin: 26rpx 0 0; padding: 0; background: transparent; color: #788186; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 400; }

.official-account-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 28rpx;
  border: 1rpx solid var(--yj-panel-border);
  border-radius: var(--yj-panel-radius);
  background: #fdfbf7;
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}
.official-account-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.official-account-card-eyebrow { color: #936820; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); font-weight: 600; letter-spacing: 2rpx; }
.official-account-card-action { flex-shrink: 0; color: #936820; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }
.official-account-card-name { display: block; margin-top: 15rpx; color: #2b302e; font-size: 29rpx; font-size: calc(29rpx + var(--yj-font-step, 0rpx)); font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.official-account-card-description { display: block; margin-top: 7rpx; color: #697377; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; overflow-wrap: anywhere; }
.official-account-overlay { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; background: rgba(26, 29, 28, .48); }
.official-account-sheet { width: 100%; padding: 14rpx 36rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fffdf8; text-align: center; }
.official-account-handle { width: 58rpx; height: 7rpx; margin: 0 auto 28rpx; border-radius: 8rpx; background: #d6d8d6; }
.official-account-sheet-title { display: block; color: #252b29; font-size: 31rpx; font-size: calc(31rpx + var(--yj-font-step, 0rpx)); font-weight: 700; overflow-wrap: anywhere; }
.official-account-sheet-note { display: block; margin-top: 8rpx; color: #788186; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; overflow-wrap: anywhere; }
.official-account-qr { display: block; width: 360rpx; height: 360rpx; margin: 30rpx auto 16rpx; background: #fff; }
.official-account-qr-error { display: flex; width: 360rpx; height: 220rpx; align-items: center; justify-content: center; margin: 30rpx auto 16rpx; padding: 20rpx; border: 1rpx solid #eae7e1; border-radius: 16rpx; color: #788186; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.official-account-wechat-id { display: block; color: #3c4441; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); overflow-wrap: anywhere; }
.official-account-copy { width: 100%; height: 78rpx; margin-top: 24rpx; border-radius: 39rpx; background: #fbf2dc; color: #775119; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }
.official-account-close { width: 100%; height: 74rpx; margin-top: 10rpx; background: transparent; color: #788186; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); }

.mine-guest-note { display: flex; flex-direction: column; gap: 9rpx; margin-top: 22rpx; padding: 28rpx; border-radius: var(--yj-panel-radius); }
.mine-guest-note text:first-child { color: #32383c; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }
.mine-guest-note text:last-child { color: #6c777b; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }

.mine-state { display: flex; min-height: 132rpx; flex-direction: column; align-items: flex-start; justify-content: center; gap: 10rpx; padding: 26rpx 28rpx; border-radius: var(--yj-panel-radius); color: #32383c; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); }
.mine-state-note { color: #6c777b; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; overflow-wrap: anywhere; }
.mine-state-action { min-height: 70rpx; margin: 5rpx 0 0; padding: 0 20rpx; border-radius: 35rpx; background: #fbf2dc; color: #775119; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); }

.web-binding-card { margin-top: 20rpx; padding: 26rpx 28rpx; border-radius: var(--yj-panel-radius); }
.web-binding-title { color: #32383c; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.web-binding-note { margin: 12rpx 0 20rpx; color: #657075; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.web-binding-card .note-input { display: block; width: 100%; height: 78rpx; margin-bottom: 15rpx; padding: 0 20rpx; border: 1rpx solid #e6e3dc; border-radius: 13rpx; background: #faf9f7; color: #2b302e; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); }
.web-binding-card .primary-button { margin-top: 6rpx; }
