.mine-page {
  padding-top: 24rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.account-row {
  display: flex;
  min-height: 132rpx;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: 22rpx;
}

.account-row-login {
  width: 100%;
  margin: 0;
  border: 0;
  line-height: 1.4;
  text-align: left;
}

.avatar {
  position: relative;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-guest { background: #f1eee8; }
.avatar-head { position: absolute; top: 20rpx; width: 29rpx; height: 29rpx; border-radius: 50%; background: #bdc1c2; }
.avatar-shoulders { position: absolute; bottom: -5rpx; width: 57rpx; height: 36rpx; border-radius: 50% 50% 0 0; background: #bdc1c2; }
.avatar-logged { background: #efe5cf; color: #8b6426; font-size: 37rpx; font-weight: 700; }
.avatar-image { width: 100%; height: 100%; }

.account-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.account-copy > text:first-child {
  display: block;
  overflow: hidden;
  color: #262b29;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-copy > text:last-child {
  display: block;
  overflow: hidden;
  color: #6c777b;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-action { flex-shrink: 0; color: #936820; font-size: 24rpx; font-weight: 600; }

.mine-chart-card, .mine-records, .settings-card {
  border-radius: 22rpx;
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}

.mine-chart-card {
  min-height: 220rpx;
  margin-top: 22rpx;
  padding: 25rpx 28rpx 24rpx;
  background: #fbf8f1;
  border: 1rpx solid #efe7d8;
}

.mine-chart-kicker {
  display: inline-block;
  color: #8b6426;
  font-size: 22rpx;
  font-weight: 600;
}

.mine-chart-content { display: flex; min-height: 138rpx; flex-direction: column; justify-content: center; }
.mine-chart-title { display: block; margin-top: 12rpx; color: #2b302e; font-size: 30rpx; font-weight: 700; overflow-wrap: anywhere; }
.mine-chart-note { display: block; margin-top: 9rpx; color: #657075; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.mine-chart-pillars { display: flex; flex-wrap: wrap; gap: 11rpx; margin-top: 15rpx; }
.mine-chart-pillars text { padding: 6rpx 12rpx; border: 1rpx solid #e4d4b7; border-radius: 11rpx; color: #74521c; font-size: 22rpx; }
.mine-chart-bottom { display: flex; min-width: 0; align-items: flex-end; justify-content: space-between; gap: 14rpx; margin-top: 16rpx; }
.mine-chart-bottom text:first-child { min-width: 0; color: #6c777b; font-size: 22rpx; overflow-wrap: anywhere; }
.mine-chart-bottom text:last-child, .mine-chart-link { flex-shrink: 0; color: #936820; font-size: 23rpx; font-weight: 600; }
.mine-chart-link { align-self: flex-end; margin-top: 17rpx; }

.mine-records { margin-top: 22rpx; padding: 0 28rpx; }
.mine-records-head { display: flex; min-height: 92rpx; align-items: center; gap: 14rpx; }
.mine-records-title { min-width: 0; flex: 1; color: #262b29; font-size: 29rpx; font-weight: 700; }
.mine-records-count { flex-shrink: 0; color: #788186; font-size: 22rpx; }
.mine-records-all { flex-shrink: 0; color: #936820; font-size: 23rpx; font-weight: 600; }
.mine-record { display: flex; min-height: 112rpx; align-items: center; gap: 16rpx; border-top: 1rpx solid #efeeea; }
.mine-record-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.mine-record-copy text:first-child { display: block; overflow: hidden; color: #32383c; font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.mine-record-copy text:last-child { color: #788186; font-size: 22rpx; }
.mine-chevron { flex-shrink: 0; color: #9da5aa; font-size: 33rpx; font-weight: 400; }
.mine-record-empty { display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; gap: 12rpx; border-top: 1rpx solid #efeeea; color: #6c777b; font-size: 23rpx; }
.mine-record-create { flex-shrink: 0; color: #936820; font-weight: 600; }

.mine-settings-title { margin: 35rpx 4rpx 17rpx; color: #303633; font-size: 27rpx; font-weight: 700; }
.settings-card { padding: 0 28rpx; }
.settings-row { display: flex; min-height: 92rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #efeeea; }
.settings-row:last-child { border-bottom: 0; }
.settings-label { min-width: 0; flex: 1; color: #414a4b; font-size: 24rpx; }
.settings-bound-email { max-width: 52%; overflow: hidden; color: #788186; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }

.mine-logout { width: 100%; min-height: 84rpx; margin: 26rpx 0 0; padding: 0; background: transparent; color: #788186; font-size: 23rpx; font-weight: 400; }

.official-account-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 28rpx;
  border: 1rpx solid #eee6d8;
  border-radius: 22rpx;
  background: #fdfbf7;
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}
.official-account-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.official-account-card-eyebrow { color: #936820; font-size: 21rpx; font-weight: 600; letter-spacing: 2rpx; }
.official-account-card-action { flex-shrink: 0; color: #936820; font-size: 22rpx; font-weight: 600; }
.official-account-card-name { display: block; margin-top: 15rpx; color: #2b302e; font-size: 29rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.official-account-card-description { display: block; margin-top: 7rpx; color: #697377; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.official-account-overlay { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; background: rgba(26, 29, 28, .48); }
.official-account-sheet { width: 100%; padding: 14rpx 36rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fff; text-align: center; }
.official-account-handle { width: 58rpx; height: 7rpx; margin: 0 auto 28rpx; border-radius: 8rpx; background: #d6d8d6; }
.official-account-sheet-title { display: block; color: #252b29; font-size: 31rpx; font-weight: 700; overflow-wrap: anywhere; }
.official-account-sheet-note { display: block; margin-top: 8rpx; color: #788186; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.official-account-qr { display: block; width: 360rpx; height: 360rpx; margin: 30rpx auto 16rpx; background: #fff; }
.official-account-qr-error { display: flex; width: 360rpx; height: 220rpx; align-items: center; justify-content: center; margin: 30rpx auto 16rpx; padding: 20rpx; border: 1rpx solid #eae7e1; border-radius: 16rpx; color: #788186; font-size: 23rpx; line-height: 1.5; }
.official-account-wechat-id { display: block; color: #3c4441; font-size: 24rpx; overflow-wrap: anywhere; }
.official-account-copy { width: 100%; height: 78rpx; margin-top: 24rpx; border-radius: 39rpx; background: #fbf2dc; color: #775119; font-size: 27rpx; font-weight: 600; }
.official-account-close { width: 100%; height: 74rpx; margin-top: 10rpx; background: transparent; color: #788186; font-size: 23rpx; }

.mine-guest-note { display: flex; flex-direction: column; gap: 9rpx; margin-top: 22rpx; padding: 28rpx; border-radius: 22rpx; }
.mine-guest-note text:first-child { color: #32383c; font-size: 26rpx; font-weight: 600; }
.mine-guest-note text:last-child { color: #6c777b; font-size: 23rpx; line-height: 1.5; }

.mine-state { display: flex; min-height: 132rpx; flex-direction: column; align-items: flex-start; justify-content: center; gap: 10rpx; padding: 26rpx 28rpx; border-radius: 22rpx; color: #32383c; font-size: 25rpx; }
.mine-state-note { color: #6c777b; font-size: 22rpx; line-height: 1.5; overflow-wrap: anywhere; }
.mine-state-action { min-height: 70rpx; margin: 5rpx 0 0; padding: 0 20rpx; border-radius: 35rpx; background: #fbf2dc; color: #775119; font-size: 23rpx; }

.web-binding-card { margin-top: 20rpx; padding: 26rpx 28rpx; border-radius: 22rpx; }
.web-binding-title { color: #32383c; font-size: 26rpx; font-weight: 700; }
.web-binding-note { margin: 12rpx 0 20rpx; color: #657075; font-size: 22rpx; line-height: 1.5; }
.web-binding-card .note-input { display: block; width: 100%; height: 78rpx; margin-bottom: 15rpx; padding: 0 20rpx; border: 1rpx solid #e6e3dc; border-radius: 13rpx; background: #faf9f7; color: #2b302e; font-size: 25rpx; }
.web-binding-card .primary-button { margin-top: 6rpx; }
