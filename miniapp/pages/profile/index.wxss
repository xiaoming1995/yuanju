.profile-page { padding-top: 30rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.profile-card { padding: 0 28rpx; }
.profile-field + .profile-field { border-top: 1rpx solid #f0eee9; }
.profile-avatar-row, .profile-nickname-row { display: flex; width: 100%; align-items: center; gap: 20rpx; }
.profile-avatar-row { min-height: 154rpx; margin: 0; padding: 24rpx 0; border: 0; border-radius: 0; background: transparent; line-height: 1.4; text-align: left; }
.profile-nickname-row { min-height: 112rpx; }
.profile-field-label { flex-shrink: 0; color: #32383c; font-size: 28rpx; font-weight: 600; }
.profile-avatar { display: flex; width: 94rpx; height: 94rpx; flex-shrink: 0; align-items: center; justify-content: center; margin-left: auto; overflow: hidden; border-radius: 50%; background: linear-gradient(145deg, #e1b24d, #c88e23); color: #fff; font-size: 38rpx; font-weight: 700; }
.profile-avatar image { width: 100%; height: 100%; }
.profile-chevron { color: #a4abb1; font-size: 36rpx; font-weight: 400; }
.profile-nickname-input { flex: 1; min-width: 0; height: 76rpx; color: #414d57; font-size: 28rpx; text-align: right; }
.profile-field-status { display: flex; align-items: center; justify-content: flex-end; gap: 18rpx; padding-bottom: 20rpx; color: #7b8790; font-size: 22rpx; line-height: 1.5; }
.profile-field-status text { min-width: 0; }
.profile-field-status.is-error { color: #ad624a; }
.profile-retry { flex-shrink: 0; margin: 0; padding: 7rpx 16rpx; border-radius: 14rpx; background: #fbf2dc; color: #946a24; font-size: 22rpx; line-height: 1.5; }
.profile-hint { margin: 22rpx 12rpx 0; color: #87909a; font-size: 23rpx; line-height: 1.6; }
.profile-onboarding-hint { margin-top: 10rpx; }
.profile-state { padding: 44rpx 30rpx; color: #78828a; font-size: 26rpx; text-align: center; line-height: 1.6; }
.profile-state .primary-button { margin-top: 30rpx; }
.profile-return { margin-top: 18rpx; background: transparent; color: #7b8790; font-size: 25rpx; }
