<view wx:if="{{navigationVisible}}" class="navigation-status"><view class="navigation-spinner"></view><text>正在打开…</text></view>
<view class="page-shell moving-page">
  <view class="paper-backdrop" aria-hidden="true"><image class="paper-backdrop-plum" src="/assets/home-plum-branch.png" mode="widthFix"></image><image class="paper-backdrop-mountains" src="/assets/home-ink-mountains.png" mode="widthFix"></image></view>
  <view class="moving-hero surface-card">
    <view class="hero-top"><text class="hero-kicker">择日 · 通用宜忌</text></view>
    <view class="hero-title">择日参考</view>
    <view class="hero-copy">选事项和日期范围，查看传统宜忌中对应的原始标签。结果是通用日期资料，具体安排仍需核对。</view>
  </view>

  <view class="activity-card surface-card">
    <view class="section-heading">选择事项</view>
    <view class="activity-grid">
      <view wx:for="{{activityOptions}}" wx:key="id" class="activity-option {{item.selected ? 'is-active' : ''}}" data-activity="{{item.id}}" bindtap="changeActivity">{{item.label}}</view>
    </view>
    <view class="activity-note">{{activity.note}}</view>
  </view>

  <view class="filter-card surface-card">
    <view class="filter-heading"><view class="section-heading">选择日期范围</view><text>最多 90 天</text></view>
    <view class="range-row">
      <picker class="range-picker" mode="date" value="{{startDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="changeStartDate">
        <view class="range-field"><text>开始日期</text><text>{{startDate || '请选择'}}</text></view>
      </picker>
      <text class="range-separator">—</text>
      <picker class="range-picker" mode="date" value="{{endDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="changeEndDate">
        <view class="range-field"><text>结束日期</text><text>{{endDate || '请选择'}}</text></view>
      </picker>
    </view>
    <view class="range-hint">支持 1900—2100 年内的有效日期；起止日期均计入筛选。</view>
  </view>

  <view wx:if="{{rangeError}}" class="range-error surface-card">{{rangeError}}</view>
  <view wx:elif="{{resultUpdating}}" class="result-feedback surface-card"><view class="navigation-spinner"></view><text>正在读取日期资料…</text></view>
  <view wx:elif="{{resultError}}" class="result-feedback surface-card"><text>{{resultError}}</text><button class="result-retry" bindtap="retryResults">重新读取</button></view>

  <block wx:else>
    <view class="result-summary surface-card">
      <view><text class="result-kicker">{{activity.label}} · 通用宜忌筛选</text><text class="result-count">{{candidateCount}}<text> 天有相关宜</text></text></view>
      <text class="result-total">共查看 {{total}} 天</text>
    </view>
    <view wx:if="{{candidateCount === 0}}" class="empty-priority surface-card">这段时间没有列出「{{activity.label}}」相关宜的日期；其他日期及原因仍可逐日核对。</view>

    <block wx:for="{{sections}}" wx:for-item="section" wx:key="id">
      <view wx:if="{{section.days.length}}" class="result-section">
        <view class="section-bar"><text class="section-title">{{section.label}}</text><text class="section-count">{{section.days.length}} 天</text></view>
        <view class="moving-day surface-card group-{{section.id}}" wx:for="{{section.visibleDays}}" wx:for-item="day" wx:key="date">
          <view class="day-header" data-date="{{day.date}}" hover-class="tap-pressed" bindtap="openDay"><view><text class="day-date">{{day.date}}</text><text class="day-lunar">{{day.lunarFull}}</text></view><text class="day-arrow">{{expandedDate === day.date ? '⌃' : '›'}}</text></view>
          <view class="day-meta"><text>{{day.dayGanZhi}}日</text><text>通用日期资料</text></view>
          <view class="day-tags"><text class="yi-tag">相关宜：{{day.yiText}}</text><text class="ji-tag">相关忌：{{day.jiText}}</text></view>
          <view class="day-reason">{{day.reason}}</view>
          <view wx:if="{{expandedDate === day.date}}" class="day-details">
            <view class="day-detail-heading">完整通用宜忌</view>
            <view class="full-tags"><text class="full-tag-label is-yi">宜</text><view class="full-tag-items"><text wx:for="{{day.allYi}}" wx:for-item="label" wx:key="*this" class="almanac-term" data-term="{{label}}" data-kind="宜" catchtap="showAlmanacTerm" role="button" aria-label="查看宜项{{label}}的解释">{{label}}</text><text wx:if="{{!day.allYi.length}}">无记录</text></view></view>
            <view class="full-tags"><text class="full-tag-label is-ji">忌</text><view class="full-tag-items"><text wx:for="{{day.allJi}}" wx:for-item="label" wx:key="*this" class="almanac-term" data-term="{{label}}" data-kind="忌" catchtap="showAlmanacTerm" role="button" aria-label="查看忌项{{label}}的解释">{{label}}</text><text wx:if="{{!day.allJi.length}}">无记录</text></view></view>
            <view class="almanac-help">点按词语查看解释</view>
            <button wx:if="{{personalChart}}" class="personal-link {{navigationKey === day.date ? 'is-opening' : ''}}" data-date="{{day.date}}" bindtap="openPersonalDay">查看本人每日参考 ›</button>
            <view wx:else class="personal-hint">绑定本人命盘后，可另行查看该日个人参考。</view>
          </view>
        </view>
        <button wx:if="{{section.hasMore}}" class="show-more" data-section="{{section.id}}" bindtap="showMore">继续显示 7 天 · 已显示 {{section.visibleDays.length}} / {{section.days.length}}</button>
      </view>
    </block>
  </block>

  <view class="moving-note">事项按上方标明的传统标签筛选；通用宜忌不包含时辰、参与人及现实条件的核对，也不提供投资买卖时机。</view>
</view>
