<view wx:if="{{navigationVisible}}" class="navigation-status"><view class="navigation-spinner"></view><text>正在打开…</text></view>
<view class="page-shell home-page {{mode === 'home' ? 'daily-home-page' : ''}}" style="--yj-font-step: {{fontStep || 0}}rpx">
  <view class="paper-backdrop" aria-hidden="true"><image class="paper-backdrop-plum" src="/assets/home-plum-branch.png" mode="widthFix"></image><image class="paper-backdrop-mountains" src="/assets/home-ink-mountains.png" mode="widthFix"></image></view>
  <view wx:if="{{mode === 'history'}}" class="history-page-header">
    <view class="history-back" data-mode="home" bindtap="switchMode" role="button"><text class="history-back-arrow">←</text><text>返回首页</text></view>
    <text class="history-page-title">我的排盘</text>
  </view>

  <block wx:if="{{mode === 'home'}}">
    <view class="today-hero">
      <view class="today-hero-top"><text class="home-section-link {{navigationKey === 'calendar' ? 'is-opening' : ''}}" bindtap="openCalendar">查看日历 ›</text></view>
      <view class="today-date"><text>{{calendarPreview.date}}</text><text>农历{{calendarPreview.lunar || (calendarLoading ? '读取中' : '暂不可用')}}</text></view>
      <view class="today-pillars"><view><text class="today-pillar-value">{{calendarPreview.yearGanZhi}}年</text><text class="today-pillar-label">年柱</text></view><view><text class="today-pillar-value">{{calendarPreview.monthGanZhi}}月</text><text class="today-pillar-label">月柱</text></view><view><text class="today-pillar-value">{{calendarPreview.dayGanZhi}}日</text><text class="today-pillar-label">日柱</text></view></view>
    </view>

    <view class="today-section today-almanac-card surface-card">
      <view class="today-heading"><text>黄历宜忌</text><view class="today-heading-rule"></view><text>通用日期资料</text></view>
      <view wx:if="{{calendarLoading}}" class="today-status">正在读取今日宜忌…</view>
      <view wx:elif="{{calendarDay}}" class="today-almanac">
        <view><text class="today-mark is-yi">宜</text><view><text wx:for="{{calendarDay.yi}}" wx:key="*this" class="almanac-term" data-term="{{item}}" data-kind="宜" bindtap="showAlmanacTerm" role="button" aria-label="查看宜项{{item}}的解释">{{item}}</text><text wx:if="{{!calendarDay.yi.length}}">无记录</text></view></view>
        <view><text class="today-mark is-ji">忌</text><view><text wx:for="{{calendarDay.ji}}" wx:key="*this" class="almanac-term" data-term="{{item}}" data-kind="忌" bindtap="showAlmanacTerm" role="button" aria-label="查看忌项{{item}}的解释">{{item}}</text><text wx:if="{{!calendarDay.ji.length}}">无记录</text></view></view>
      </view>
      <view wx:else class="today-status">{{calendarError || '今日宜忌暂不可用'}}</view>
      <view wx:if="{{calendarDay}}" class="almanac-help">点按词语查看解释</view>
    </view>

    <view class="today-section today-personal-card surface-card">
      <view class="today-heading"><text>本人每日主题</text><view class="today-heading-rule"></view><text>本人命盘</text></view>
      <view wx:if="{{personalLoading}}" class="today-status">正在读取个人参考…</view>
      <view wx:elif="{{personalState === 'unbound'}}" class="today-status">尚未配置本人命盘。<text class="today-inline-link" bindtap="openPersonalSetup">去「我的」设置 ›</text></view>
      <view wx:elif="{{personalState === 'error'}}" class="today-status">{{personalError || '个人参考暂不可用'}}<text class="today-inline-link" bindtap="refreshToday">重试 ›</text></view>
      <view wx:elif="{{personalThemes.length}}" class="today-personal-list">
        <view wx:for="{{personalThemes}}" wx:key="id" class="today-personal">
          <view class="today-personal-title"><text>{{item.title}}</text><text class="today-guidance-level level-{{item.level}}">{{item.label}}</text></view>
          <text class="today-personal-source">依据：{{item.source_label}}</text>
          <text class="today-personal-summary">{{item.summary}}</text>
          <text wx:if="{{item.actions && item.actions.length}}" class="today-personal-action">建议：{{item.actions[0]}}</text>
        </view>
      </view>
      <view wx:else class="today-status">{{personalDay && !personalDay.theme_guidance ? '今日主题参考暂不可用。' : '今日暂无特别提示。'}}</view>
      <block wx:if="{{personalDay}}">
        <view class="today-verdict"><text class="today-verdict-title">当日干支关系 · {{personalDay.day_gan_zhi}}日</text><view><text class="today-verdict-label status-{{personalDay.status}}">{{personalDay.label}}</text><text>{{personalDay.summary}}</text></view></view>
        <view wx:if="{{personalDirections.length}}" class="today-directions"><view wx:for="{{personalDirections}}" wx:key="name"><text>{{item.name}}</text><text>{{item.direction}}</text></view></view>
      </block>
    </view>

    <view class="today-section today-luck-card surface-card">
      <view class="today-heading"><text>方位与色彩参考</text><view class="today-heading-rule"></view><text>{{personalDay && personalDay.luck && personalDay.luck.available ? (personalDay.luck.level === 'qualified' ? '有条件参考' : (personalDay.luck.level === 'baseline' ? '命盘基础' : '今日喜用')) : '个人五行推算'}}</text></view>
      <view wx:if="{{personalLoading}}" class="today-status">正在读取个人五行参考…</view>
      <view wx:elif="{{personalState === 'unbound'}}" class="today-status">配置本人命盘后可查看。</view>
      <view wx:elif="{{personalState === 'error'}}" class="today-status">方位与颜色参考暂不可用。</view>
      <view wx:elif="{{personalDay && personalDay.luck && personalDay.luck.available}}"><view class="today-luck"><view><text>参考方位</text><text>{{personalDay.luck.direction}}</text></view><view><text>参考颜色</text><text>{{personalDay.luck.color}}</text></view></view><view class="today-footnote">{{personalDay.luck.reason}}</view></view>
      <view wx:else class="today-status">{{personalDay && personalDay.luck ? personalDay.luck.reason : '方位与颜色参考暂不可用。'}}</view>
    </view>
    <view class="today-footer"><view class="today-detail-link {{navigationKey === 'personal' ? 'is-opening' : ''}}" bindtap="openTodayDetail">查看今日完整依据 ›</view><view class="today-boundary">本工具仅为传统文化娱乐参考，不构成决策指导。</view></view>
  </block>

  <block wx:else>
    <view class="history-lead">已有记录仅供选择本人命盘；未设置的记录不开放完整详情。</view>
    <view wx:if="{{personalChartId}}" class="history-personal-status"><text>已设置本人命盘</text><text class="history-unbind" bindtap="unbindPersonalChart">解绑 ›</text></view>
    <view class="history-card surface-card" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="openHistoryDetail">
      <view class="history-top"><text class="history-name">{{item.name}}</text><text class="trash-control" data-id="{{item.id}}" catchtap="removeHistory">删除</text></view>
      <text class="history-date">{{item.date}}</text>
      <view class="history-pillars"><view wx:for="{{item.columns}}" wx:for-item="pillar" wx:for-index="pillarIndex" wx:key="text" class="history-pillar"><text class="history-pillar-label">{{pillarIndex === 0 ? '年柱' : pillarIndex === 1 ? '月柱' : pillarIndex === 2 ? '日柱' : '时柱'}}</text><text class="history-pillar-value tone-{{pillar.tone}}">{{pillar.text}}</text></view></view>
      <view class="history-card-footer"><button wx:if="{{personalChartId !== item.id}}" class="personal-bind-button" data-id="{{item.id}}" catchtap="bindPersonalChart">设为本人命盘</button><text wx:else class="personal-bound-label">本人命盘</text><text class="history-view-more">{{personalChartId === item.id ? '查看详情 ›' : '仅可设为本人命盘'}}</text></view>
    </view>
    <view wx:if="{{history.length === 0}}" class="empty-history surface-card">{{historyLoading ? '正在加载...' : '暂无历史记录，可在「我的」设置本人命盘。'}}</view>
    <button wx:if="{{history.length === 0 && !historyLoading}}" class="primary-button history-create-button" bindtap="openPersonalSetup">去配置本人命盘</button>
    <button wx:if="{{hasMore}}" class="primary-button history-load-more" loading="{{historyLoading}}" bindtap="loadMoreHistory">加载更多</button>
  </block>
</view>

<view wx:if="{{detail}}" class="overlay detail-overlay" style="--yj-font-step: {{fontStep || 0}}rpx">
  <view class="overlay-backdrop" bindtap="closeHistoryDetail"></view>
  <view class="history-dialog surface-card">
    <view class="dialog-head"><text>{{detail.name}}</text><text bindtap="closeHistoryDetail">×</text></view>
    <view class="dialog-date">{{detail.date}}</view>
    <view class="history-pillars dialog-pillars"><text wx:for="{{detail.columns}}" wx:for-item="pillar" wx:key="text" class="tone-{{pillar.tone}}">{{pillar.text}}</text></view>
    <button class="primary-button" bindtap="openDetailResult">查看完整干支</button>
  </view>
</view>
