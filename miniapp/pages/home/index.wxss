.home-page {
  padding-top: 24rpx;
  padding-bottom: 52rpx;
}

.home-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin-bottom: 18rpx;
}

.home-page-title {
  color: #282d2b;
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.home-nav-link {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding-left: 20rpx;
  color: #805a20;
  font-size: 24rpx;
  white-space: nowrap;
}

.history-page-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.history-back {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  color: #59615c;
  font-size: 24rpx;
}

.history-back-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #e8e4dc;
  border-radius: 50%;
  background: #fff;
  color: #805a20;
  font-size: 28rpx;
}

.history-page-title {
  margin-top: 12rpx;
  color: #282d2b;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.home-page .section-heading {
  margin: 34rpx 0 16rpx;
  font-size: 27rpx;
}

.home-page .section-heading::before {
  display: none;
}

.home-page .surface-card {
  border-radius: 22rpx;
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}

.query-card {
  padding: 27rpx 25rpx 25rpx;
}

.query-explainer {
  margin-bottom: 26rpx;
  color: #747b78;
  font-size: 23rpx;
  line-height: 1.5;
}

.form-label {
  margin-bottom: 11rpx;
  color: #48514d;
  font-size: 24rpx;
  font-weight: 600;
}

.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.field-hint {
  color: #858b87;
  font-size: 21rpx;
  white-space: nowrap;
}

.date-trigger, .note-input {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e6e3dc;
  border-radius: 13rpx;
  background: #faf9f7;
  color: #2b302e;
  font-size: 28rpx;
}

.date-trigger {
  justify-content: space-between;
}

.chevron {
  color: #828985;
  font-size: 32rpx;
}

.note-label {
  margin-top: 24rpx;
}

.gender-options {
  display: flex;
  gap: 16rpx;
}

.gender-option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  border: 1rpx solid #e6e3dc;
  border-radius: 13rpx;
  background: #fff;
  color: #606965;
  font-size: 25rpx;
}

.gender-option.is-active {
  border-color: #b99452;
  background: #fbf8f1;
  color: #775119;
  font-weight: 700;
}

.note-input {
  box-sizing: border-box;
}

.query-button {
  height: 84rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 13rpx;
  background: #8b6424;
  color: #fff;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.home-page button.query-button[disabled] {
  border-color: #a88b5d;
  background: #a88b5d;
  color: #fff;
}

.query-footnote {
  margin-top: 17rpx;
  color: #5f6b74;
  font-size: 23rpx;
  text-align: center;
}

.home-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-section-link {
  display: flex;
  align-items: center;
  min-height: 62rpx;
  padding-left: 15rpx;
  color: #805a20;
  font-size: 24rpx;
}

.today-card {
  padding: 25rpx 25rpx 20rpx;
}

.today-date {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 14rpx;
}

.today-date text:first-child {
  font-size: 29rpx;
  font-weight: 700;
}

.today-date text:last-child {
  color: #8b929b;
  font-size: 22rpx;
}

.today-pillars {
  display: flex;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #efede8;
}

.today-pillars > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  padding: 0 4rpx;
}

.today-pillars > view + view {
  border-left: 1rpx solid #efede8;
}

.today-pillar-label {
  color: #8f9499;
  font-size: 20rpx;
}

.today-pillar-value {
  color: #775119;
  font-size: 29rpx;
  font-weight: 700;
}

.today-footnote {
  margin-top: 19rpx;
  color: #7c8580;
  font-size: 22rpx;
}

.recent-card {
  padding: 22rpx 25rpx;
}

.recent-main, .recent-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 700;
}

.recent-pillars {
  display: flex;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.recent-pillars > text {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.recent-pillars > text:first-child {
  text-align: left;
}

.recent-sub {
  margin-top: 8rpx;
  color: #87909a;
  font-size: 22rpx;
}

.recent-arrow {
  color: #acb1b7;
  font-size: 32rpx;
  line-height: 1;
}

.recent-empty {
  color: #87909a;
  font-size: 23rpx;
}

.history-lead {
  margin: 10rpx 0 24rpx;
  color: #7b827d;
  font-size: 23rpx;
  line-height: 1.55;
}

.history-personal-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 74rpx;
  margin-bottom: 22rpx;
  padding: 0 20rpx;
  border: 1rpx solid #efe4d0;
  border-radius: 13rpx;
  background: #fcf8f0;
  color: #805a20;
  font-size: 23rpx;
}

.history-unbind {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding-left: 22rpx;
  font-size: 22rpx;
}

.home-page .history-card {
  margin-bottom: 20rpx;
  padding: 25rpx 25rpx 20rpx;
  border: 1rpx solid #ebe7df;
  border-radius: 18rpx;
  box-shadow: none;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 38rpx;
}

.history-name {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 700;
}

.trash-control {
  flex: none;
  padding: 7rpx 0 7rpx 18rpx;
  color: #87908a;
  font-size: 22rpx;
}

.history-date {
  display: block;
  margin-top: 5rpx;
  color: #8a938d;
  font-size: 22rpx;
}

.history-pillars {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx 4rpx;
  border-radius: 12rpx;
  background: #f8f7f3;
}

.history-pillar {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.history-pillar + .history-pillar {
  border-left: 1rpx solid #e8e5df;
}

.history-pillar-label {
  color: #929a94;
  font-size: 20rpx;
}

.history-pillar-value {
  font-size: 29rpx;
  font-weight: 700;
}

.history-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  margin-top: 15rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #efede8;
}

.history-view-more {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding-left: 15rpx;
  color: #805a20;
  font-size: 23rpx;
}

.personal-bound-label {
  padding: 10rpx 15rpx;
  border-radius: 9rpx;
  background: #f8f1e4;
  color: #856323;
  font-size: 21rpx;
}

.history-footnote, .empty-history {
  padding: 22rpx;
  color: #5f6b74;
  font-size: 24rpx;
  text-align: center;
}

.home-page .empty-history {
  border: 1rpx solid #ebe7df;
  box-shadow: none;
}

.home-page .history-create-button {
  height: 84rpx;
  margin-top: 18rpx;
  border: 0;
  border-radius: 13rpx;
  background: #8b6424;
  color: #fff;
}

.home-page .history-load-more {
  margin-top: 12rpx;
  border-radius: 13rpx;
}

.overlay {
  position: fixed;
  z-index: 30;
  inset: 0;
}

.overlay-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(21, 24, 27, 0.36);
}

.picker-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 22rpx);
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
}

.picker-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 85rpx;
  padding: 0 30rpx;
  color: #657080;
  font-size: 24rpx;
}

.picker-title { color: #2d3135; font-weight: 700; }
.picker-toolbar > text:first-child, .picker-confirm { padding: 14rpx 17rpx; }
.picker-confirm { color: #80550f; font-weight: 700; }
.date-picker { width: 100%; height: 380rpx; }
.picker-option { display: flex; align-items: center; justify-content: center; height: 80rpx; font-size: 27rpx; }
.picker-hint { padding: 12rpx 26rpx 0; color: #5f6b74; font-size: 23rpx; text-align: center; }

.detail-overlay { display: flex; align-items: center; justify-content: center; }
.history-dialog { position: relative; width: 620rpx; padding: 30rpx; text-align: center; }
.dialog-head { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: 700; }
.dialog-head > text:last-child { color: #8a929b; font-size: 34rpx; }
.dialog-date { margin-top: 16rpx; color: #758290; font-size: 24rpx; text-align: left; }
.dialog-pillars { justify-content: space-between; margin: 22rpx 0; }
.dialog-note { margin-bottom: 25rpx; color: #8c969f; font-size: 21rpx; text-align: left; }
.personal-bind-button { display: flex; align-items: center; justify-content: center; min-height: 68rpx; margin: 0; padding: 0 17rpx; border: 1rpx solid #e5d5b8; border-radius: 10rpx; background: #fff; color: #805a20; font-size: 22rpx; line-height: 1; }
