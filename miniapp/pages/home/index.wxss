.home-page {
  padding-top: 24rpx;
  padding-bottom: 52rpx;
}

.history-page-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.history-back {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  color: #59615c;
  font-size: 24rpx;
}

.history-back-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #e8e4dc;
  border-radius: 50%;
  background: #fff;
  color: #805a20;
  font-size: 28rpx;
}

.history-page-title {
  margin-top: 12rpx;
  color: #282d2b;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.home-page .section-heading {
  margin: 34rpx 0 16rpx;
  font-size: 27rpx;
}

.home-page .section-heading::before {
  display: none;
}

.home-page .surface-card {
  border-radius: 22rpx;
  box-shadow: 0 5rpx 24rpx rgba(40, 42, 41, 0.04);
}

.home-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-section-link {
  display: flex;
  align-items: center;
  min-height: 62rpx;
  padding-left: 15rpx;
  color: #805a20;
  font-size: 24rpx;
}

.today-card {
  padding: 28rpx 28rpx 22rpx;
}

.today-date {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 14rpx;
}

.today-date text:first-child {
  font-size: 32rpx;
  font-weight: 600;
}

.today-date text:last-child {
  color: #8b929b;
  font-size: 22rpx;
}

.today-pillars {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
}

.today-pillars > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  padding: 13rpx 4rpx;
  border-radius: 10rpx;
  background: #f8f7f4;
}

.today-pillars > view + view {
  border-left: 0;
}

.today-pillar-label {
  color: #8f9499;
  font-size: 20rpx;
}

.today-pillar-value {
  color: #38362f;
  font-size: 27rpx;
  font-weight: 600;
}

.today-divider { margin: 25rpx 0; border-top: 1rpx solid #efede8; }
.today-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 14rpx; }
.today-heading text:first-child { color: #30322f; font-size: 26rpx; font-weight: 600; }
.today-heading text:last-child { color: #8d938e; font-size: 20rpx; text-align: right; }
.today-almanac { display: flex; flex-direction: column; gap: 11rpx; }
.today-almanac > view { display: flex; align-items: flex-start; gap: 15rpx; }
.today-almanac > view > view { display: flex; min-width: 0; flex-wrap: wrap; gap: 4rpx 12rpx; }
.today-almanac > view > view text { padding: 3rpx 8rpx; border-radius: 6rpx; background: #f5f5f3; color: #505a55; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.today-mark { flex-shrink: 0; font-size: 23rpx; font-weight: 700; line-height: 1.5; }
.today-mark.is-yi { color: #2e664e; }
.today-mark.is-ji { color: #8b463a; }
.today-status { color: #7f8982; font-size: 22rpx; line-height: 1.55; }
.today-inline-link { color: #936c2c; }
.today-personal { padding: 18rpx 0; border-top: 1rpx solid #efede8; }
.today-personal:first-child { padding-top: 0; border-top: 0; }
.today-personal:last-child { padding-bottom: 0; }
.today-personal-title { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #303831; font-size: 24rpx; font-weight: 600; }
.today-personal-title > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.today-guidance-level { flex-shrink: 0; padding: 4rpx 9rpx; border-radius: 8rpx; background: #f0f2f3; color: #67737b; font-size: 20rpx; }
.today-guidance-level.level-candidate { background: #eef7f1; color: #2e664e; }
.today-guidance-level.level-review { background: #fbf2df; color: #8b5f16; }
.today-personal-source { display: block; margin-top: 6rpx; color: #a27730; font-size: 19rpx; }
.today-personal-summary { display: block; margin-top: 8rpx; color: #535e58; font-size: 22rpx; line-height: 1.5; }
.today-verdict { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; color: #535e58; font-size: 22rpx; line-height: 1.5; }
.today-verdict-label { flex-shrink: 0; padding: 5rpx 10rpx; border-radius: 8rpx; background: #f8f2e5; color: #775119; font-weight: 600; }
.today-verdict-label.status-caution, .today-verdict-label.status-mixed { background: #f9ede8; color: #8b463a; }
.today-verdict-label.status-insufficient, .today-verdict-label.status-undetermined { background: #f0f2f3; color: #78828b; }
.today-directions { margin-top: 12rpx; }
.today-directions > view { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 6rpx 0; color: #5b666e; font-size: 21rpx; }
.today-directions > view > text:last-child { flex-shrink: 0; color: #a27730; }
.today-luck { display: flex; gap: 12rpx; }
.today-luck > view { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; padding: 17rpx; border-radius: 11rpx; background: #faf8f1; }
.today-luck > view text:first-child { color: #887f6f; font-size: 20rpx; }
.today-luck > view text:last-child { color: #805f27; font-size: 26rpx; font-weight: 600; }
.today-detail-link { display: flex; align-items: center; justify-content: flex-end; min-height: 70rpx; margin-top: 22rpx; border-top: 1rpx solid #efede8; color: #936c2c; font-size: 22rpx; }

.today-footnote {
  margin-top: 11rpx;
  color: #7c8580;
  font-size: 20rpx;
  line-height: 1.5;
}

.recent-card {
  padding: 22rpx 25rpx;
}

.recent-main, .recent-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recent-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 700;
}

.recent-pillars {
  display: flex;
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.recent-pillars > text {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.recent-pillars > text:first-child {
  text-align: left;
}

.recent-sub {
  margin-top: 8rpx;
  color: #87909a;
  font-size: 22rpx;
}

.recent-arrow {
  color: #acb1b7;
  font-size: 32rpx;
  line-height: 1;
}

.recent-empty {
  color: #87909a;
  font-size: 23rpx;
}

.history-lead {
  margin: 10rpx 0 24rpx;
  color: #7b827d;
  font-size: 23rpx;
  line-height: 1.55;
}

.history-personal-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 74rpx;
  margin-bottom: 22rpx;
  padding: 0 20rpx;
  border: 1rpx solid #efe4d0;
  border-radius: 13rpx;
  background: #fcf8f0;
  color: #805a20;
  font-size: 23rpx;
}

.history-unbind {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding-left: 22rpx;
  font-size: 22rpx;
}

.home-page .history-card {
  margin-bottom: 20rpx;
  padding: 25rpx 25rpx 20rpx;
  border: 1rpx solid #ebe7df;
  border-radius: 18rpx;
  box-shadow: none;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 38rpx;
}

.history-name {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  font-weight: 700;
}

.trash-control {
  flex: none;
  padding: 7rpx 0 7rpx 18rpx;
  color: #87908a;
  font-size: 22rpx;
}

.history-date {
  display: block;
  margin-top: 5rpx;
  color: #8a938d;
  font-size: 22rpx;
}

.history-pillars {
  display: flex;
  margin-top: 20rpx;
  padding: 18rpx 4rpx;
  border-radius: 12rpx;
  background: #f8f7f3;
}

.history-pillar {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.history-pillar + .history-pillar {
  border-left: 1rpx solid #e8e5df;
}

.history-pillar-label {
  color: #929a94;
  font-size: 20rpx;
}

.history-pillar-value {
  font-size: 29rpx;
  font-weight: 700;
}

.history-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  margin-top: 15rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #efede8;
}

.history-view-more {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding-left: 15rpx;
  color: #805a20;
  font-size: 23rpx;
}

.personal-bound-label {
  padding: 10rpx 15rpx;
  border-radius: 9rpx;
  background: #f8f1e4;
  color: #856323;
  font-size: 21rpx;
}

.history-footnote, .empty-history {
  padding: 22rpx;
  color: #5f6b74;
  font-size: 24rpx;
  text-align: center;
}

.home-page .empty-history {
  border: 1rpx solid #ebe7df;
  box-shadow: none;
}

.home-page .history-create-button {
  height: 84rpx;
  margin-top: 18rpx;
  border: 0;
  border-radius: 13rpx;
  background: #8b6424;
  color: #fff;
}

.home-page .history-load-more {
  margin-top: 12rpx;
  border-radius: 13rpx;
}

.overlay {
  position: fixed;
  z-index: 30;
  inset: 0;
}

.overlay-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(21, 24, 27, 0.36);
}

.detail-overlay { display: flex; align-items: center; justify-content: center; }
.history-dialog { position: relative; width: 620rpx; padding: 30rpx; text-align: center; }
.dialog-head { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: 700; }
.dialog-head > text:last-child { color: #8a929b; font-size: 34rpx; }
.dialog-date { margin-top: 16rpx; color: #758290; font-size: 24rpx; text-align: left; }
.dialog-pillars { justify-content: space-between; margin: 22rpx 0; }
.dialog-note { margin-bottom: 25rpx; color: #8c969f; font-size: 21rpx; text-align: left; }
.personal-bind-button { display: flex; align-items: center; justify-content: center; min-height: 68rpx; margin: 0; padding: 0 17rpx; border: 1rpx solid #e5d5b8; border-radius: 10rpx; background: #fff; color: #805a20; font-size: 22rpx; line-height: 1; }
