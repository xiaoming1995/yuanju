.calendar-page { padding-top: 7rpx; padding-bottom: 72rpx; }
.calendar-toolbar { display: flex; justify-content: space-between; align-items: center; min-height: 96rpx; padding: 0 4rpx 10rpx; }
.month-navigation { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.month-title { color: #352419; font-size: 34rpx; font-size: calc(34rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.month-arrow { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 60rpx; height: 70rpx; color: #5f6b74; font-size: 42rpx; font-size: calc(42rpx + var(--yj-font-step, 0rpx)); }
.calendar-actions { display: flex; align-items: center; gap: 12rpx; }
.today-control { display: flex; align-items: center; justify-content: center; min-width: 88rpx; height: 64rpx; padding: 0 14rpx; border-radius: 32rpx; background: #f3eee3; color: #775119; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.calendar-card { padding: 28rpx 13rpx 24rpx; }
.weekday-row, .day-grid { display: flex; flex-wrap: wrap; }
.weekday-row > text { display: block; width: 14.2857%; margin-bottom: 14rpx; color: #8f806d; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); text-align: center; }
.day-cell { position: relative; display: flex; width: 14.2857%; min-height: 104rpx; align-items: flex-start; justify-content: center; }
.day-inner { position: relative; display: flex; width: 76rpx; max-width: 100%; min-height: 92rpx; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; border-radius: 20rpx; }
.solar-day { font-size: 29rpx; font-size: calc(29rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.lunar-day { max-width: 100%; overflow: hidden; color: #7e878f; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.lunar-day.has-jieqi { color: #775119; font-weight: 700; }
.day-cell.is-other .solar-day, .day-cell.is-other .lunar-day { color: #c8cbce; }
.day-inner.is-selected { background: #775119; }
.day-inner.is-selected .solar-day, .day-inner.is-selected .lunar-day { color: #fff; }
.day-inner.is-today { box-shadow: inset 0 0 0 2rpx #a47c3b; }
.day-inner.is-selected.is-today { box-shadow: inset 0 0 0 3rpx #e8c98d; }
.almanac-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #e9d8b8; }
.almanac-heading .section-heading { margin: 0; }
.almanac-heading > text { color: #8b949d; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); }
.almanac-status { padding: 15rpx 0 3rpx; color: #7f8992; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.almanac-list { margin-top: 12rpx; }
.almanac-row { display: flex; align-items: flex-start; gap: 12rpx; padding: 10rpx 0; }
.almanac-mark { flex-shrink: 0; width: 37rpx; line-height: 1.6; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.almanac-mark.is-yi { color: #2e664e; }
.almanac-mark.is-ji { color: #8b463a; }
.almanac-items { display: flex; min-width: 0; flex-wrap: wrap; gap: 8rpx; }
.almanac-items > text { max-width: 100%; padding: 3rpx 0; color: #5a5147; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); line-height: 1.4; overflow-wrap: anywhere; }
.almanac-items > .almanac-empty { color: #89939b; }
.selected-term { margin-top: 10rpx; color: #a87620; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.selected-jianchu { display: flex; align-items: center; gap: 11rpx; flex-wrap: wrap; margin-top: 18rpx; padding-top: 15rpx; border-top: 1rpx solid #f0efeb; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.selected-jianchu > text:first-child { color: #89929a; }
.selected-jianchu .jianchu-value { padding: 5rpx 11rpx; border-radius: 9rpx; background: #fbf2dc; color: #a97619; font-weight: 700; }
.selected-jianchu .jianchu-meaning { color: #768189; }
.moving-entry { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; padding: 26rpx 28rpx; }
.moving-entry-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.moving-entry-title { color: #a7761d; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.moving-entry-subtitle { color: #5f6b74; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.4; }
.moving-entry-arrow { flex-shrink: 0; color: #b68939; font-size: 36rpx; font-size: calc(36rpx + var(--yj-font-step, 0rpx)); }
.personal-day-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #f0efeb; }
.personal-day-heading .section-heading { margin: 0; }
.personal-day-heading .demo-tag { flex-shrink: 0; }
.personal-day-invite { margin: 16rpx 0 18rpx; color: #7f8992; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; }
.personal-day-start { display: flex; align-items: center; justify-content: center; min-height: 76rpx; margin: 0; border: 1rpx solid #eadbbf; border-radius: 40rpx; background: #fbf2dc; color: #775119; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.personal-day-demo { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; margin-top: 12rpx; color: #6d777f; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
.personal-day-demo text { color: #a47c3b; }
.personal-day-open { padding-top: 16rpx; }
.personal-day-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #89939b; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); overflow-wrap: anywhere; }
.personal-day-meta > text:last-child { flex-shrink: 0; color: #be841c; }
.personal-day-verdict { display: flex; align-items: center; gap: 14rpx; margin-top: 19rpx; }
.personal-status { padding: 8rpx 18rpx; border-radius: 13rpx; background: #f8f2e5; color: #775119; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.personal-status.status-caution { background: #f9ede8; color: #8b463a; }
.personal-status.status-insufficient, .personal-status.status-neutral, .personal-status.status-undetermined { background: #f0f2f3; color: #78828b; }
.personal-day-ganzhi { color: #485057; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 600; }
.personal-day-summary { margin-top: 14rpx; color: #4f5c65; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; }
.personal-day-tips { display: flex; gap: 12rpx; margin-top: 18rpx; }
.personal-day-tips > view { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; padding: 15rpx; border-radius: 15rpx; background: #faf8f4; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.personal-day-tips > view > text:first-child { color: #859099; }
.personal-day-tips > view > text:last-child { color: #333b3c; font-weight: 700; }
.personal-day-link { margin-top: 14rpx; color: #936c2c; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); text-align: right; }
.personal-highlight { margin-top: 16rpx; }
.personal-highlight-title { display: flex; align-items: center; gap: 12rpx; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.personal-highlight-title > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.personal-highlight .personal-day-summary { margin-top: 8rpx; }
.personal-more { margin-top: 10rpx; color: #8b949d; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.guidance-heading { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 18rpx; color: #333b3c; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.guidance-heading text { flex-shrink: 0; color: #8b949d; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); font-weight: 400; }
.guidance-list { margin-top: 8rpx; }
.guidance-item { padding: 13rpx 0; border-top: 1rpx solid #f0efeb; }
.guidance-item-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.guidance-item-head > text:first-child { min-width: 0; }
.guidance-level { flex-shrink: 0; padding: 5rpx 10rpx; border-radius: 10rpx; background: #f0f2f3; color: #67737b; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.guidance-level.level-candidate { background: #eef7f1; color: #2e664e; }
.guidance-level.level-review { background: #fbf2df; color: #8b5f16; }
.guidance-source { margin-top: 4rpx; color: #a27730; font-size: 21rpx; font-size: calc(21rpx + var(--yj-font-step, 0rpx)); }
.guidance-summary { margin-top: 5rpx; color: #5b666e; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); line-height: 1.4; overflow-wrap: anywhere; }
.calendar-details { min-height: 252rpx; margin-top: 28rpx; overflow: hidden; }
.calendar-tabs { display: flex; min-height: 98rpx; border-bottom: 1rpx solid #ececec; }
.calendar-tabs > view { position: relative; display: flex; width: 50%; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #758193; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); }
.calendar-tabs > view.active { color: #775119; font-weight: 700; }
.calendar-tabs > view.active::after { position: absolute; bottom: 0; width: 42rpx; height: 5rpx; border-radius: 5rpx; background: #c9a669; content: ""; }
.term-tab-summary { color: #9aa2aa; font-size: 21rpx; font-size: calc(21rpx + var(--yj-font-step, 0rpx)); font-weight: 400; }
.calendar-tabs > view.active .term-tab-summary { color: #bf8b2e; }
.date-details, .term-list { padding: 20rpx 25rpx 27rpx; }
.detail-kicker { color: #9b7a39; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
.ganzhi-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
.ganzhi-row > view { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; gap: 8rpx; padding: 11rpx 0; border-radius: 12rpx; background: #faf7f0; }
.ganzhi-row text { color: #8e969e; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.ganzhi-row .ganzhi-value { color: #775119; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.detail-hint { margin-top: 18rpx; color: #5f6b74; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.date-detail-link { display: flex; align-items: center; justify-content: flex-end; min-height: 70rpx; margin-top: 18rpx; padding-top: 9rpx; border-top: 1rpx solid #e9d8b8; color: #775119; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); }
.term-month-head { display: flex; justify-content: space-between; color: #8b929b; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.term-item { display: flex; align-items: center; gap: 14rpx; margin-top: 13rpx; padding: 12rpx 16rpx; border-radius: 14rpx; background: #faf8f4; }
.term-day { width: 45rpx; color: #c78b1e; font-size: 32rpx; font-size: calc(32rpx + var(--yj-font-step, 0rpx)); font-weight: 700; text-align: center; }
.term-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 4rpx; }
.term-name { color: #32383c; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.term-meta { color: #8b949d; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); }
.term-arrow { color: #a4acb2; font-size: 29rpx; font-size: calc(29rpx + var(--yj-font-step, 0rpx)); }
