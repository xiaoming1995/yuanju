.result-page {
  padding-top: 16rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 44rpx);
}

.query-summary { padding: 24rpx 27rpx; }
.summary-heading { display: flex; align-items: center; justify-content: space-between; color: #657080; font-size: 23rpx; }
.summary-date { margin-top: 13rpx; color: #263039; font-size: 32rpx; font-weight: 700; }
.summary-note { margin-top: 10rpx; color: #637080; font-size: 23rpx; overflow-wrap: anywhere; }
.summary-hint { margin-top: 15rpx; padding-top: 15rpx; border-top: 1rpx solid #f0eee9; color: #4f5c65; font-size: 24rpx; line-height: 1.55; }

.result-card { padding: 20rpx 24rpx 18rpx; }
.result-title { text-align: center; font-size: 27rpx; font-weight: 700; }
.result-divider { height: 1rpx; margin: 16rpx 0 19rpx; background: #ececec; }
.pillar-grid { display: flex; gap: 12rpx; }
.pillar-cell { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; padding: 13rpx 4rpx 15rpx; border: 1rpx solid #e8e9ea; border-radius: 18rpx; background: linear-gradient(180deg, #fafafa, #f7f7f7); }
.pillar-label { margin-bottom: 8rpx; color: #657284; font-size: 22rpx; }
.pillar-char { height: 42rpx; font-size: 36rpx; font-weight: 700; line-height: 42rpx; }
.result-mingge { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 17rpx; color: #75648f; font-size: 23rpx; font-weight: 700; }
.result-mingge-label { padding: 3rpx 10rpx; border-radius: 8rpx; background: #f0ebf5; color: #75648f; font-size: 19rpx; }
.result-caption { display: flex; align-items: center; gap: 10rpx; margin-top: 17rpx; color: #5f6b74; font-size: 23rpx; }

.natal-panel { padding: 22rpx 25rpx; }
.natal-heading { display: flex; align-items: center; justify-content: space-between; color: #27313b; font-size: 26rpx; font-weight: 700; }
.natal-line { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 19rpx; }
.natal-label { flex: none; width: 112rpx; color: #7a838b; font-size: 21rpx; line-height: 38rpx; }
.natal-values { display: flex; min-width: 0; flex: 1; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; }
.natal-primary { color: #a16e20; font-size: 27rpx; font-weight: 700; line-height: 38rpx; }
.natal-detail { color: #5f6b74; font-size: 23rpx; line-height: 1.5; }
.natal-stem { color: #556b5a; font-size: 23rpx; line-height: 38rpx; }
.natal-stem--adverse { color: #94645c; }
.natal-fuyi { margin-top: 20rpx; padding-top: 17rpx; border-top: 1rpx solid #f0eee9; color: #4f5c65; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.natal-pattern { margin-top: 19rpx; padding-top: 18rpx; border-top: 1rpx solid #f0eee9; }
.natal-pattern-title { display: flex; align-items: center; gap: 14rpx; color: #7a838b; font-size: 21rpx; }
.natal-pattern-title text:last-child { color: #75648f; font-size: 25rpx; font-weight: 700; }
.natal-pattern-desc { margin-top: 12rpx; color: #4f5c65; font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; }

.birth-grid { display: flex; gap: 12rpx; padding: 16rpx; }
.birth-item { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; padding: 13rpx; border: 1rpx solid #e8e8e8; border-radius: 18rpx; font-size: 22rpx; }
.birth-label { color: #657080; }
.birth-muted { color: #a1a8af; font-size: 19rpx; }

.basic-panel { overflow: hidden; padding: 21rpx 15rpx 20rpx; }
.basic-intro { margin: 0 5rpx 16rpx; color: #87919c; font-size: 20rpx; }
.basic-grid { display: grid; grid-template-columns: 72rpx repeat(4, minmax(0, 1fr)); gap: 1rpx; overflow: hidden; border: 1rpx solid #e9e4da; border-radius: 14rpx; background: #e9e4da; }
.matrix-label, .matrix-cell { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; padding: 12rpx 4rpx; background: #fff; color: #4e5b66; font-size: 23rpx; text-align: center; overflow-wrap: anywhere; }
.matrix-label { background: #faf7f1; color: #8b806e; font-size: 20rpx; font-weight: 600; }
.matrix-head { min-height: 60rpx; background: #f8f5ef; color: #a47b34; font-size: 22rpx; font-weight: 700; }
.matrix-cell.is-day { background: #fffcf5; }
.matrix-main { font-size: 38rpx; font-weight: 700; line-height: 1.1; }
.matrix-element { color: #5f6b74; font-size: 22rpx; }
.matrix-part { display: block; line-height: 1.45; }
.matrix-tag { padding: 2rpx 5rpx; border-radius: 6rpx; background: #f9f3e7; color: #775119; font-size: 21rpx; }
.shensha-label { color: #c6733b; }

.wuxing-panel { padding: 20rpx 22rpx 22rpx; }
.wuxing-caption { margin-bottom: 12rpx; color: #929ba4; font-size: 21rpx; }
.wuxing-row { display: flex; align-items: center; gap: 12rpx; height: 38rpx; padding: 0 4rpx; font-size: 22rpx; }
.wuxing-row > text:first-child { width: 25rpx; }
.wuxing-row > text:last-child { width: 70rpx; color: #808894; text-align: right; }
.wuxing-track { flex: 1; height: 10rpx; border-radius: 10rpx; background: #eeeeee; }
.wuxing-fill { height: 100%; border-radius: 10rpx; }
.wuxing-fill.wood { background: #219e77; }
.wuxing-fill.fire { background: #ce4c39; }
.wuxing-fill.earth { background: #c89a2f; }
.wuxing-fill.metal { background: #dec05c; }
.wuxing-fill.water { background: #4995cb; }
.return-button { margin-top: 32rpx; }
