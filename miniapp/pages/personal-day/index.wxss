.personal-page { padding-top: 20rpx; padding-bottom: calc(52rpx + env(safe-area-inset-bottom)); }
.personal-hero { padding: 28rpx; background: linear-gradient(145deg, #24292a, #111719); color: #fff; }
.almanac-card { margin-top: 22rpx; padding: 25rpx; }
.almanac-card .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 0 0 13rpx; }
.almanac-card .section-heading > text { color: #8b949d; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); font-weight: 400; }
.almanac-row { display: flex; align-items: flex-start; gap: 12rpx; padding: 9rpx 0; }
.almanac-mark { flex-shrink: 0; width: 37rpx; line-height: 1.6; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.almanac-mark.is-yi { color: #2e664e; }
.almanac-mark.is-ji { color: #8b463a; }
.almanac-items { display: flex; min-width: 0; flex-wrap: wrap; gap: 8rpx; }
.almanac-items > text { padding: 4rpx 10rpx; border-radius: 8rpx; background: #f7f7f4; color: #465158; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); line-height: 1.4; }
.almanac-items > .almanac-empty { color: #89939b; }
.almanac-items > .almanac-term { display: inline-flex; min-height: 44rpx; align-items: center; border-bottom: 1rpx dotted #a6b4aa; }
.almanac-help { margin-top: 10rpx; color: #8b949d; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); }
.hero-top { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.hero-kicker { color: #e3b65c; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); letter-spacing: 2rpx; }
.hero-date { margin-top: 27rpx; font-size: 39rpx; font-size: calc(39rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.hero-lunar { margin-top: 8rpx; color: #c4cac9; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
.hero-pillars { display: flex; gap: 12rpx; margin-top: 28rpx; }
.hero-pillars > view { display: flex; flex: 1; align-items: center; justify-content: center; gap: 10rpx; padding: 15rpx 3rpx; border: 1rpx solid rgba(255, 255, 255, .13); border-radius: 13rpx; background: rgba(255, 255, 255, .07); font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); }
.hero-pillars > view > text:first-child { color: #a9b2af; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.selection-card { margin-top: 22rpx; padding: 25rpx; }
.selection-card .section-heading { margin: 0 0 16rpx; }
.selection-mapping { color: #5f6b74; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.selection-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.selection-tags > text { max-width: 100%; padding: 8rpx 13rpx; border-radius: 11rpx; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); overflow-wrap: anywhere; }
.selection-yi { background: #eef7f1; color: #2e664e; }
.selection-ji { background: #fbf0ed; color: #8b463a; }
.selection-reason { margin-top: 16rpx; color: #4f5c65; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; }
.jianchu-card { margin-top: 22rpx; padding: 25rpx; overflow: hidden; }
.jianchu-card .section-heading { margin: 0 0 18rpx; }
.jianchu-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; color: #929ca1; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.jianchu-label { padding: 9rpx 19rpx; border-radius: 13rpx; background: #fbf1da; color: #a6751d; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.jianchu-copy { margin-top: 15rpx; color: #59656b; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.jianchu-sequence { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 8rpx; margin-top: 21rpx; }
.jianchu-item { display: flex; flex: 0 0 15%; align-items: center; justify-content: center; min-height: 52rpx; border-radius: 9rpx; background: #f4f4f2; color: #949da2; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.jianchu-item.is-current { background: #d39a2f; color: #fff; font-weight: 700; }
.jianchu-note { margin-top: 16rpx; color: #5f6b74; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.personal-intro, .personal-profile, .personal-verdict, .personal-evidence, .personal-activities { margin-top: 22rpx; padding: 25rpx; }
.personal-intro .section-heading, .personal-verdict .section-heading, .personal-evidence .section-heading, .personal-activities .section-heading { margin: 0 0 18rpx; }
.personal-intro > view:nth-child(2) { color: #78838a; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.6; }
.personal-intro .primary-button { margin-top: 23rpx; }
.personal-profile { display: flex; align-items: center; gap: 16rpx; }
.profile-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; flex-shrink: 0; border-radius: 18rpx; background: #faf1df; color: #bd8520; font-size: 31rpx; font-size: calc(31rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.profile-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; }
.profile-copy > text:first-child { font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.profile-copy > text:last-child { color: #929ba2; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); }
.profile-badge { flex-shrink: 0; color: #b07b1e; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); }
.verdict-line { display: flex; align-items: center; gap: 14rpx; color: #7a858b; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
.verdict-badge { padding: 10rpx 19rpx; border-radius: 14rpx; background: #fbf1da; color: #775119; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.verdict-badge.verdict-caution { background: #f9eae5; color: #8b463a; }
.verdict-badge.verdict-insufficient, .verdict-badge.verdict-neutral, .verdict-badge.verdict-undetermined { background: #f0f2f3; color: #78838a; }
.verdict-summary { margin-top: 17rpx; color: #515e62; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.6; }
.direction-list { margin-top: 16rpx; }
.luck-level { color: #9b7130; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.direction-list > view { display: flex; justify-content: space-between; gap: 12rpx; padding: 8rpx 0; color: #5b666e; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.direction-list > view > text:last-child { flex-shrink: 0; color: #a27730; }
.fuyi-line { display: flex; gap: 10rpx; flex-wrap: wrap; }
.fuyi-line > text { padding: 10rpx 15rpx; border-radius: 12rpx; background: #faf8f4; color: #a77b27; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); }
.evidence-list { margin-top: 14rpx; }
.evidence-list > view { display: flex; gap: 12rpx; padding: 13rpx 0; color: #505c62; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; }
.evidence-dot { width: 9rpx; height: 9rpx; flex-shrink: 0; margin-top: 12rpx; border-radius: 50%; background: #d5a039; }
.evidence-foot, .evidence-empty { margin-top: 14rpx; color: #5f6b74; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; }
.activity-row { padding: 18rpx 0; border-top: 1rpx solid #f0efed; }
.activity-row:first-child { border-top: 0; padding-top: 0; }
.activity-head { display: flex; justify-content: space-between; gap: 15rpx; font-size: 27rpx; font-size: calc(27rpx + var(--yj-font-step, 0rpx)); font-weight: 700; }
.activity-head > text:last-child { color: #bc8523; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
.activity-detail { margin-top: 10rpx; color: #7b858c; font-size: 24rpx; font-size: calc(24rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; }
.activity-action { margin-top: 9rpx; color: #4d6257; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; overflow-wrap: anywhere; }
.activity-source { margin-top: 7rpx; color: #a27730; font-size: 22rpx; font-size: calc(22rpx + var(--yj-font-step, 0rpx)); }
.activity-evidence { margin-top: 7rpx; color: #7b858c; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); line-height: 1.5; overflow-wrap: anywhere; }
.guidance-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.guidance-section-head > text { color: #a27730; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); flex-shrink: 0; }
.personal-activities .guidance-section-head .section-heading { margin-bottom: 18rpx; }
.guidance-level { flex-shrink: 0; padding: 5rpx 10rpx; border-radius: 10rpx; background: #f0f2f3; color: #67737b; font-size: 23rpx; font-size: calc(23rpx + var(--yj-font-step, 0rpx)); }
.guidance-level.level-candidate { background: #eef7f1; color: #2e664e; }
.guidance-level.level-review { background: #fbf2df; color: #8b5f16; }
.personal-boundary { display: flex; align-items: flex-start; gap: 12rpx; margin: 25rpx 4rpx 0; color: #5f6b74; font-size: 26rpx; font-size: calc(26rpx + var(--yj-font-step, 0rpx)); line-height: 1.55; }
.personal-boundary .demo-tag { flex-shrink: 0; }
.end-preview { margin-top: 28rpx; background: transparent; color: #9a8b70; font-size: 25rpx; font-size: calc(25rpx + var(--yj-font-step, 0rpx)); }
