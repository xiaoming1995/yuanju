<view wx:if="{{navigationVisible}}" class="navigation-status"><view class="navigation-spinner"></view><text>正在打开…</text></view>
<view class="page-shell personal-page" style="--yj-font-step: {{fontStep || 0}}rpx">
  <view class="paper-backdrop" aria-hidden="true"><image class="paper-backdrop-plum" src="/assets/home-plum-branch.png" mode="widthFix"></image><image class="paper-backdrop-mountains" src="/assets/home-ink-mountains.png" mode="widthFix"></image></view>
  <block wx:if="{{realMode}}">
    <view class="personal-hero paper-feature-hero">
      <view class="hero-top"><text class="hero-kicker">每日干支参考 · {{realDay ? '本人命盘' : '通用日期'}}</text><text class="demo-tag">{{realDay ? '真实排盘' : (realLoading ? '检查中' : '未绑定')}}</text></view>
      <view class="hero-date">{{dateLabel}}</view>
      <view wx:if="{{calendarDay}}" class="hero-lunar">农历{{calendarDay.lunar_full}} · {{calendarDay.year_gan_zhi}}年 {{calendarDay.month_gan_zhi}}月 {{calendarDay.day_gan_zhi}}日</view>
    </view>
    <view class="almanac-card surface-card">
      <view class="section-heading">黄历宜忌 <text>通用日期资料</text></view>
      <view wx:if="{{calendarLoading}}" class="evidence-empty">正在读取该日宜忌…</view>
      <view wx:elif="{{calendarDay}}">
        <view class="almanac-row"><text class="almanac-mark is-yi">宜</text><view class="almanac-items"><text wx:for="{{calendarDay.yi}}" wx:key="*this" class="almanac-term" data-term="{{item}}" data-kind="宜" bindtap="showAlmanacTerm" role="button" aria-label="查看宜项{{item}}的解释">{{item}}</text><text wx:if="{{!calendarDay.yi.length}}" class="almanac-empty">无记录</text></view></view>
        <view class="almanac-row"><text class="almanac-mark is-ji">忌</text><view class="almanac-items"><text wx:for="{{calendarDay.ji}}" wx:key="*this" class="almanac-term" data-term="{{item}}" data-kind="忌" bindtap="showAlmanacTerm" role="button" aria-label="查看忌项{{item}}的解释">{{item}}</text><text wx:if="{{!calendarDay.ji.length}}" class="almanac-empty">无记录</text></view></view>
        <view class="almanac-help">点按词语查看解释</view>
      </view>
      <view wx:else class="evidence-empty">{{calendarError || '该日宜忌暂不可用'}}</view>
    </view>
    <view wx:if="{{realLoading}}" class="personal-intro surface-card">正在计算所选日期与本人命盘的关系…</view>
    <view wx:elif="{{realError}}" class="personal-intro surface-card">{{realError}}<button class="primary-button" bindtap="openBinding">去「我的」查看</button></view>
    <view wx:elif="{{!realDay}}" class="personal-intro surface-card">
      <view class="section-heading">尚未绑定本人命盘</view>
      <view>可在「我的」配置本人命盘，再查看个人事项提示。</view>
      <button class="primary-button" bindtap="openBinding">去「我的」配置</button>
      <button class="end-preview" bindtap="useDemo">使用固定示例体验</button>
    </view>
    <block wx:else>
      <view class="personal-profile surface-card"><view class="profile-icon">命</view><view class="profile-copy"><text>{{realDay.chart_name}}</text><text>日柱{{realDay.chart_day}} · 已主动绑定</text></view></view>
      <view class="personal-activities surface-card">
        <view class="guidance-section-head"><view class="section-heading">本人每日主题</view><text wx:if="{{personalThemes.length}}" bindtap="toggleActivityEvidence">{{showActivityEvidence ? '收起依据' : '查看依据 ›'}}</text></view>
        <view wx:if="{{!personalThemes.length}}" class="evidence-empty">{{realDay.theme_guidance ? '所选日期暂无特别提示。' : '今日主题参考暂不可用。'}}</view>
        <view class="activity-row" wx:for="{{personalThemes}}" wx:key="id">
          <view class="activity-head"><text>{{item.title}}</text><text class="guidance-level level-{{item.level}}">{{item.label}}</text></view>
          <view class="activity-source">依据：{{item.source_label}}</view>
          <view class="activity-detail">{{item.summary}}</view>
          <view class="activity-action" wx:for="{{item.actions}}" wx:for-item="action" wx:key="*this">{{action}}</view>
          <block wx:if="{{showActivityEvidence}}"><view class="activity-evidence" wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="*this">{{evidence}}</view></block>
        </view>
      </view>
      <view class="personal-verdict surface-card"><view class="section-heading">当日干支与本人命盘</view><view class="verdict-line"><text class="verdict-badge verdict-{{realDay.status}}">{{realDay.label}}</text><text>{{realDay.day_gan_zhi}}日</text></view><view class="verdict-summary">{{realDay.summary}}</view><view wx:if="{{realDirections.length}}" class="direction-list"><view wx:for="{{realDirections}}" wx:key="name"><text>{{item.name}}</text><text>{{item.direction}}</text></view></view></view>
      <view class="personal-verdict surface-card"><view class="section-heading">方位与色彩参考</view><block wx:if="{{realDay.luck && realDay.luck.available}}"><view class="luck-level">{{realDay.luck.level === 'qualified' ? '有条件参考' : (realDay.luck.level === 'baseline' ? '命盘基础参考' : '今日喜用对应')}}</view><view class="direction-list"><view><text>参考方位</text><text>{{realDay.luck.direction}}</text></view><view><text>参考颜色</text><text>{{realDay.luck.color}}</text></view></view><view class="verdict-summary">{{realDay.luck.reason}}</view></block><view wx:else class="verdict-summary">{{realDay.luck ? realDay.luck.reason : '方位与颜色参考暂不可用。'}}</view></view>
      <view class="personal-evidence surface-card"><view class="section-heading">判断依据</view><view class="fuyi-line"><text>扶抑喜用：{{realDay.favorable || '依据不足'}}</text><text>扶抑忌神：{{realDay.adverse || '依据不足'}}</text></view><view wx:if="{{realDay.evidence.length}}" class="evidence-list"><view wx:for="{{realDay.evidence}}" wx:key="*this"><text class="evidence-dot"></text><text>{{item}}</text></view></view><view wx:else class="evidence-empty">当前资料不足，没有形成个人关系判断。</view><view class="evidence-foot">日支仅按主气五行展示。</view></view>
      <view class="personal-boundary">以上内容仅供参考，不能据此预测具体事件，也不构成投资、医疗或其他重大决策依据。</view>
    </block>
  </block>
  <block wx:else>
  <view class="personal-hero paper-feature-hero">
    <view class="hero-top"><text class="hero-kicker">每日干支参考 · 前端演示</text><text class="demo-tag">演示数据</text></view>
    <view class="hero-date">{{dateLabel}}</view>
    <view class="hero-lunar">农历{{lunarFull}}<text wx:if="{{jieQi}}"> · {{jieQi}}</text></view>
    <view class="hero-pillars"><view><text>年</text><text>{{yearGanZhi}}</text></view><view><text>月</text><text>{{monthGanZhi}}</text></view><view><text>日</text><text>{{dayGanZhi}}</text></view></view>
  </view>

  <view wx:if="{{selection}}" class="selection-card surface-card">
    <view class="section-heading">{{selection.activityLabel}} · 日期依据</view>
    <view class="selection-mapping">{{selection.note}}</view>
    <view class="selection-tags"><text class="selection-yi">宜：{{selection.yiText}}</text><text class="selection-ji">忌：{{selection.jiText}}</text></view>
    <view class="selection-reason">{{selection.reason}}</view>
  </view>

  <view class="jianchu-card surface-card">
    <view class="section-heading">建除十二值</view>
    <view class="jianchu-head"><text class="jianchu-label">{{jianChuInfo.label}}</text><text>通用日期信息</text></view>
    <view wx:if="{{jianChuInfo.meaning}}" class="jianchu-copy">{{jianChuInfo.meaning}}</view>
    <view wx:else class="jianchu-copy">所选日期暂无建除数据。</view>
    <view class="jianchu-sequence"><text class="jianchu-item {{name === jianChuInfo.name ? 'is-current' : ''}}" wx:for="{{jianChuNames}}" wx:for-item="name" wx:key="*this">{{name}}</text></view>
    <view class="jianchu-note">建除按月支与日支循环，是传统的通用日期标签；这里不把单一建除值当作个人喜忌或事项结论。</view>
  </view>

  <view wx:if="{{!enabled}}" class="personal-intro surface-card">
    <view class="section-heading">尚未启用体验</view>
    <view>这里使用固定的示例干支展示页面效果，不需要真实登录，也不会保存生辰资料。</view>
    <button class="primary-button" bindtap="startPreview">使用示例干支体验</button>
  </view>

  <block wx:else>
    <view class="personal-profile surface-card">
      <view class="profile-icon">命</view>
      <view class="profile-copy"><text>示例干支</text><text>{{chartDate}} · 日柱{{chartDay}}</text></view>
      <text class="profile-badge">模拟绑定</text>
    </view>

    <view class="personal-verdict surface-card">
      <view class="section-heading">当天与干支的关系</view>
      <view class="verdict-line"><text class="verdict-badge verdict-{{personalDay.status}}">{{personalDay.label}}</text><text>{{dayGanZhi}}日</text></view>
      <view class="verdict-summary">{{personalDay.summary}}</view>
    </view>

    <view class="personal-evidence surface-card">
      <view class="section-heading">判断依据</view>
      <view class="fuyi-line"><text>扶抑喜用：{{favorable}}</text><text>扶抑忌神：{{adverse}}</text></view>
      <view wx:if="{{personalDay.evidence.length}}" class="evidence-list">
        <view wx:for="{{personalDay.evidence}}" wx:key="*this"><text class="evidence-dot"></text><text>{{item}}</text></view>
      </view>
      <view wx:else class="evidence-empty">当前资料不足，没有形成个人关系判断。</view>
      <view class="evidence-foot">演示规则仅比较日干、日支主气的扶抑方向，并提示日支相冲。</view>
    </view>

    <view wx:if="{{!selection}}" class="personal-activities surface-card">
      <view class="section-heading">事项提醒</view>
      <view wx:if="{{personalDay.activities.length}}">
        <view class="activity-row" wx:for="{{personalDay.activities}}" wx:key="id">
          <view class="activity-head"><text>{{item.title}}</text><text>{{item.tip}}</text></view>
          <view class="activity-detail">{{item.detail}}</view>
        </view>
      </view>
      <view wx:else class="evidence-empty">依据不足，暂不展示事项提醒。</view>
    </view>

    <view class="personal-boundary"><text class="demo-tag">原型说明</text><text>以上为固定干支和预置日历的演示关系，不是完整择日结果。时辰、参与人及实际安排仍需另行核对；这里不提供投资买卖时机。</text></view>
    <button class="end-preview {{navigationKey === 'back' ? 'is-opening' : ''}}" hover-class="tap-pressed" bindtap="endPreview">结束示例体验</button>
  </block>
  </block>
</view>
